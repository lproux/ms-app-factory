{
  "name": "@app-factory/orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "import": "./dist/index.js", "types": "./dist/index.d.ts" } },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo:multi-terminal": "node --experimental-strip-types --experimental-transform-types --no-warnings ../../tools/multi-terminal-demo.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@app-factory/shared": "workspace:*",
    "execa": "^9.5.2",
    "nanoid": "^5.0.9"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
